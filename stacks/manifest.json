{
  "stacks": {
    "traefik": {
      "source": "stacks/traefik",
      "target": "/opt/stacks/traefik",
      "approval": true
    },
    "tinyauth": {
      "source": "stacks/tinyauth",
      "target": "/opt/stacks/tinyauth",
      "auto": true,
      "approval": true
    },
    "pocket-id": {
      "source": "stacks/pocket-id",
      "target": "/opt/stacks/pocket-id",
      "auto": true,
      "approval": true
    },
    "crafty-controller": {
      "source": "stacks/crafty-controller",
      "target": "/opt/stacks/crafty-controller",
      "auto": true,
      "approval": true
    },
    "1000110-xyz": {
      "source": "stacks/1000110-xyz",
      "target": "/opt/stacks/1000110-xyz",
      "auto": true
    },
    "jarmisutode-hu": {
      "source": "stacks/jarmisutode-hu",
      "target": "/opt/stacks/sites/jarmisutode-hu",
      "auto": true
    },
    "rsystem2005-hu": {
      "source": "stacks/rsystem2005-hu",
      "target": "/opt/stacks/sites/rsystem2005-hu",
      "auto": true
    },
    "uptime-kuma": {
      "source": "kuma",
      "target": "/opt/stacks/uptime-kuma",
      "include": [
        "compose.yaml",
        "monitors.json",
        "provision.py",
        "provision.sh",
        "README.md"
      ],
      "auto": true
    },
    "sc2bp": {
      "source": "sc2bp",
      "target": "/opt/stacks/sc2bp",
      "auto": true,
      "include": [
        "compose.yaml",
        "Dockerfile",
        "requirements.txt",
        "README.md",
        "*.py"
      ]
    },
    "ruminant": {
      "source": "ruminant",
      "target": "/opt/stacks/ruminant",
      "auto": true,
      "include": [
        "compose.yaml",
        "Dockerfile",
        "requirements.txt",
        "README.md",
        "*.py"
      ]
    }
  }
}
