# Copy to .env on the server; never commit .env itself.
#
# The SHA-256 (64 lowercase hex characters) of the Anna's Archive account key that the
# KOReader plugin sends as `Authorization: Bearer <key>`. The key itself must never be
# stored on the server. Compute the hash without echoing the key:
#
#   python3 -c 'import getpass, hashlib; print(hashlib.sha256(getpass.getpass("key: ").encode()).hexdigest())'
ANNAS_KEY_SHA256=