# Copy to /opt/stacks/inbox-zero/.env on the server (chmod 600); never commit .env itself.

# Exact public origin with no trailing slash; must match the Google OAuth callback URIs.
NEXT_PUBLIC_BASE_URL=https://mail.1000110.xyz

# Postgres (hex password so it stays URL-safe inside DATABASE_URL / DIRECT_URL)
POSTGRES_USER=inboxzero
POSTGRES_PASSWORD=                                  # openssl rand -hex 24
POSTGRES_DB=inboxzero

# Upstash-compatible HTTP Redis bridge (serverless-redis-http)
UPSTASH_REDIS_TOKEN=                                # openssl rand -hex 32

# App secrets (never change EMAIL_ENCRYPT_SECRET / EMAIL_ENCRYPT_SALT after first sign-in)
AUTH_SECRET=                                        # openssl rand -hex 32
EMAIL_ENCRYPT_SECRET=                               # openssl rand -hex 32
EMAIL_ENCRYPT_SALT=                                 # openssl rand -hex 16
INTERNAL_API_KEY=                                   # openssl rand -hex 32
API_KEY_SALT=                                       # openssl rand -hex 32
CRON_SECRET=                                        # openssl rand -hex 32

# Access control: comma-separated Google accounts allowed to sign in
AUTH_ALLOWED_EMAILS=

# Google OAuth + Gmail Pub/Sub push notifications
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC_NAME=projects/<project>/topics/inbox-zero-emails
GOOGLE_PUBSUB_VERIFICATION_TOKEN=                   # openssl rand -hex 32 (same token as push URL ?token=)

# LLM via OpenRouter (defaults shown; override DEFAULT_LLM_MODEL / ECONOMY_LLM_MODEL to tune spend)
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4.6
ECONOMY_LLM_PROVIDER=openrouter
ECONOMY_LLM_MODEL=anthropic/claude-haiku-4.5
LLM_API_KEY=

# Alternative providers (also require matching provider key in compose.yaml if switched away from OpenRouter):
# --- Anthropic ---
# DEFAULT_LLM_PROVIDER=anthropic
# DEFAULT_LLM_MODEL=claude-sonnet-4-6
# ECONOMY_LLM_PROVIDER=anthropic
# ECONOMY_LLM_MODEL=claude-haiku-4-5-20251001
# --- OpenAI ---
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_MODEL=gpt-5.4-mini
# ECONOMY_LLM_PROVIDER=openai
# ECONOMY_LLM_MODEL=gpt-5.4-nano
# --- Google Gemini (AI Studio) ---
# DEFAULT_LLM_PROVIDER=google
# DEFAULT_LLM_MODEL=gemini-3.0-flash-preview
# ECONOMY_LLM_PROVIDER=google
# ECONOMY_LLM_MODEL=gemini-2.5-flash
