# Copy to .env on the server; never commit .env itself.
#
# --- the books site (https://books.1000110.xyz) ------------------------------------------------
# Pocket ID client "Books", redirect URI https://books.1000110.xyz/auth/callback, allowed group books.
OIDC_ISSUER=https://id.1000110.xyz
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Random 32-byte hex: openssl rand -hex 32. Signs the session cookie.
SESSION_SECRET=
# Random hex: openssl rand -hex 24. The e-reader sends it as `Authorization: Bearer`.
SYNC_TOKEN=
ALLOWED_GROUP=books