# Copy to .env on the server; never commit .env itself.
#
# --- the owner's raw API (/api) ---------------------------------------------------------------
# The SHA-256 (64 lowercase hex characters) of the Anna's Archive account key that the KOReader
# plugin sends as `Authorization: Bearer <key>`. Compute the hash without echoing the key:
#
#   python3 -c 'import getpass, hashlib; print(hashlib.sha256(getpass.getpass("key: ").encode()).hexdigest())'
ANNAS_KEY_SHA256=
#
# The key itself, used by the books worker to talk to Anna's Archive. The server holds it; it is
# never committed, never in an image.
ANNAS_KEY=

# --- the books site (https://books.1000110.xyz) ------------------------------------------------
# Pocket ID client "Books", redirect URI https://books.1000110.xyz/auth/callback, allowed group books.
OIDC_ISSUER=https://id.1000110.xyz
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Random 32-byte hex: openssl rand -hex 32. Signs the session cookie.
SESSION_SECRET=
# Random hex: openssl rand -hex 24. The e-reader sends it as `Authorization: Bearer`.
SYNC_TOKEN=
ALLOWED_GROUP=books